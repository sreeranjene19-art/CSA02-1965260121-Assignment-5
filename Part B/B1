#include <stdio.h>

long long calls = 0;

long long power_linear(long long base, int exp)
{
    calls++;

    if (exp == 0)
        return 1;

    return base * power_linear(base, exp - 1);
}

long long power_fast(long long base, int exp)
{
    calls++;

    if (exp == 0)
        return 1;

    long long half = power_fast(base, exp / 2);

    if (exp % 2 == 0)
        return half * half;

    return base * half * half;
}

long long power_iterative(long long base, int exp)
{
    long long result = 1;

    while (exp > 0) {
        if (exp % 2 == 1)
            result *= base;

        base *= base;
        exp /= 2;
    }

    return result;
}

int digital_root(int n)
{
    if (n < 10)
        return n;

    int sum = 0;

    while (n > 0) {
        sum += n % 10;
        n /= 10;
    }

    return digital_root(sum);
}

int main(void)
{
    calls = 0;
    printf("Digital root: %d\n", digital_root(9875));

    calls = 0;
    printf("Linear: %lld\n", power_linear(2, 10));
    printf("Linear calls: %lld\n", calls);

    calls = 0;
    printf("Fast: %lld\n", power_fast(2, 10));
    printf("Fast calls: %lld\n", calls);

    printf("Iterative: %lld\n", power_iterative(2, 10));

    return 0;
}
