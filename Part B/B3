#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void)
{
    char name[20];

    printf("Enter donor name using scanf: ");

    if (scanf("%19s", name) != 1) {
        printf("Invalid input\n");
        return 1;
    }

    printf("Name: %s\n", name);

    getchar();

    printf("Enter donor name using fgets: ");

    if (fgets(name, sizeof(name), stdin) == NULL) {
        printf("Input error\n");
        return 1;
    }

    name[strcspn(name, "\n")] = '\0';

    printf("Name: %s\n", name);

    FILE *fp = fopen("missing.txt", "r");

    if (fp == NULL) {
        perror("File opening failed");
    } else {
        fclose(fp);
    }

    return 0;
}
